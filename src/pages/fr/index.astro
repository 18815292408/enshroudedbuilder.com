---
import Base from "../../layouts/Base.astro";
import { BUILDS, type Build } from "../../data/builds";
import { SITE, SOURCES } from "../../lib/site";
import { BIOMES, MAX_POINTS, TREE, pointsAtLevel } from "../../lib/tree";

const biomeTotal = BIOMES.reduce((a, b) => a + b.points, 0);
const levelTotal = MAX_POINTS - biomeTotal;

/**
 * French entry point. Written for the questions French players actually type
 * ("meilleur build enshrouded", "build enshrouded solo", "quel build choisir"),
 * not generated by translating the English home page.
 */
const FR_BUILD_PAGES: Record<string, string> = {
  battlemage: "/fr/builds/mage/",
  wizard: "/fr/builds/mage/",
  summoner: "/fr/builds/mage/",
  warrior: "/fr/builds/guerrier/",
  tank: "/fr/builds/guerrier/",
  ranger: "/fr/builds/archer/",
  assassin: "/fr/builds/archer/",
};
const frHref = (b: Build) => FR_BUILD_PAGES[b.slug] ?? `/builds/${b.slug}/`;
const frOnly = (b: Build) => Boolean(FR_BUILD_PAGES[b.slug]);
const DIFF_FR: Record<string, string> = { Easy: "Facile", Medium: "Moyen", Hard: "Difficile" };

const faq = [
  {
    q: "Quel est le meilleur build pour débuter Enshrouded 1.0 ?",
    a: "Le Mage de bataille (Battlemage) : baguette et protection, il tient tout seul sa mana, reste à distance moyenne et pardonne les erreurs. Le build Invocateur est aussi très simple en solo parce que les invocations prennent l'aggro à votre place.",
  },
  {
    q: "Combien de points de compétence peut-on avoir au niveau 50 ?",
    a: `212 points au total : ${levelTotal} points viennent des niveaux (2 par niveau à partir du niveau 2) et ${biomeTotal} viennent des Racines du Voile (1 point) et des Puits d'élixir (3 points) répartis dans les sept biomes.`,
  },
  {
    q: "Faut-il refaire son build après la mise à jour 1.0 ?",
    a: "Oui, une seule fois : Keen Games réinitialise l'arbre de compétences la première fois que vous chargez une sauvegarde existante en 1.0. Vous devez donc redistribuer vos points.",
  },
  {
    q: "Les noms de compétences sont-ils en français sur cette page ?",
    a: "Non, et c'est volontaire. Les compétences gardent le nom qu'elles portent dans le planificateur et dans le client anglais, parce que c'est ce que vous verrez en cliquant sur un lien de build. Le texte qui les entoure, lui, est écrit en français.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Builds Enshrouded 1.0 en français",
    url: `${SITE.url}/fr/`,
    inLanguage: "fr",
    hasPart: BUILDS.map((b) => ({ "@type": "Article", headline: `${b.name} — build Enshrouded 1.0`, url: `${SITE.url}${frHref(b)}` })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base
  lang="fr"
  altPath="/"
  title="Builds Enshrouded 1.0 en français : quel build choisir ?"
  description="Les 8 builds Enshrouded 1.0 expliqués en français : ordre exact des 212 points de compétence, équipement niveau 50, tier list et conseils solo ou coop."
  jsonLd={jsonLd}
 
>
  <section class="wrap pt-14">
    <p class="eyebrow mb-2">Guides en français</p>
    <h1 class="text-4xl md:text-5xl max-w-3xl">Quel build choisir dans Enshrouded 1.0 ?</h1>
    <p class="text-ash mt-4 max-w-3xl text-lg">
      Huit builds niveau 50 couvrant tous les styles de combat de l'arbre 1.0, avec l'ordre exact des points et l'équipement.
      Cette page est le point d'entrée : les guides détaillés par classe sont en français, les autres renvoient vers les fiches anglaises.
    </p>

    <div class="panel panel-ornate p-5 md:p-6 mt-8 max-w-3xl not-prose">
      <p class="eyebrow !text-flame mb-3">À qui s'adresse cette page</p>
      <ul class="space-y-2 text-ash">
        <li class="flex gap-2"><span class="text-spirit">→</span><span>Vous jouez en français et vous en avez assez des guides traduits à la machine où « skill tree » devient « arbre de compétence » sans que personne n'ait vérifié les chiffres.</span></li>
        <li class="flex gap-2"><span class="text-spirit">→</span><span>Vous obtenez l'ordre des points niveau par niveau, calculé sur les données du jeu 1.0 (build {TREE.source.gameBuild}) et contrôlé jusqu'à {MAX_POINTS} points.</span></li>
        <li class="flex gap-2"><span class="text-ember">→</span><span>Vous ne trouverez pas de builds inventés ni de notes sorties de nulle part : le tier et les points forts sont un avis éditorial, assumé comme tel.</span></li>
      </ul>
    </div>

    <div class="mt-7 flex flex-wrap gap-3">
      <a class="btn btn-flame" href="/fr/builds/mage/">Build mage</a>
      <a class="btn btn-ghost" href="/fr/builds/guerrier/">Build guerrier</a>
      <a class="btn btn-ghost" href="/fr/builds/archer/">Build archer</a>
      <a class="btn btn-ghost" href="/fr/arbre-de-competences/">Arbre de compétences</a>
    </div>
  </section>

  <section class="wrap mt-14">
    <h2 class="text-2xl mb-3">Le niveau 50 et les 212 points</h2>
    <p class="text-ash max-w-3xl">
      En 1.0 le plafond de personnage est le niveau 50, et chaque niveau au-delà du premier rapporte 2 points. Cela fait {levelTotal} points « de niveau ».
      Le reste vient du monde : chaque Racine du Voile donne 1 point, chaque Puits d'élixir en donne 3. Un joueur qui a terminé les sept biomes dispose de {MAX_POINTS} points,
      et c'est ce budget total que les guides utilisent, pas seulement les points de niveau.
    </p>
    <div class="panel overflow-x-auto mt-5 not-prose">
      <table class="table-game">
        <thead><tr><th>Biome</th><th>Points disponibles</th></tr></thead>
        <tbody>
          {BIOMES.map((biome) => (
            <tr><td class="text-parchment">{biome.name}</td><td>{biome.points}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-sm text-mist mt-3">Total des biomes : {biomeTotal} points. Les noms de biomes restent en anglais, comme dans le jeu et dans le planificateur. Détail des paliers et des branches dans <a href="/fr/arbre-de-competences/" class="underline hover:text-flame">l'arbre de compétences</a>.</p>
  </section>

  <section class="wrap mt-14">
    <h2 class="text-2xl mb-3">Les 8 builds de la 1.0</h2>
    <p class="text-ash max-w-3xl mb-5">Le tier est notre avis, pas une donnée du jeu. La difficulté décrit la tolérance aux erreurs, pas la puissance brute.</p>
    <div class="panel overflow-x-auto not-prose">
      <table class="table-game min-w-[46rem]">
        <thead><tr><th>Build</th><th>Tier</th><th>Difficulté</th><th>Modes</th><th>Armes</th><th>Attributs</th></tr></thead>
        <tbody>
          {BUILDS.map((b) => (
            <tr>
              <td>
                <a href={frHref(b)} class="text-parchment hover:text-flame">{b.name}</a>
                {frOnly(b) && <span class="ml-2 text-[0.7rem] uppercase tracking-wider text-spirit">en français</span>}
              </td>
              <td>{b.tier}</td>
              <td>{DIFF_FR[b.difficulty]}</td>
              <td>{b.modes.join(" · ")}</td>
              <td>{b.weapons}</td>
              <td>{b.stats}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap mt-14">
    <h2 class="text-2xl mb-3">Quel build pour quel joueur ?</h2>
    <div class="grid md:grid-cols-3 gap-4 mt-5">
      <div class="panel p-5">
        <p class="eyebrow !text-spirit mb-2">Solo</p>
        <p class="text-ash">Mage de bataille ou Invocateur. Les deux couvrent leurs propres dégâts et leur survie : la baguette et la protection pour l'un, les invocations pour l'autre. C'est ce qui compte quand personne ne peut vous relever.</p>
      </div>
      <div class="panel p-5">
        <p class="eyebrow !text-flame mb-2">Coop</p>
        <p class="text-ash">Soigneur et Tank prennent toute leur valeur à plusieurs. Le Tank tient l'aggro et absorbe, le Soigneur convertit la mana en soins et en résurrection : deux rôles qui n'ont presque pas de sens seul.</p>
      </div>
      <div class="panel p-5">
        <p class="eyebrow !text-ember mb-2">Première partie</p>
        <p class="text-ash">Évitez l'Assassin (difficile, dépend des critiques et du poison) et le Guerrier à deux mains au tout début : les deux demandent de connaître les fenêtres d'attaque des ennemis.</p>
      </div>
    </div>
  </section>

  <section class="wrap mt-14">
    <h2 class="text-2xl mb-3">Comment ces builds sont vérifiés</h2>
    <p class="text-ash max-w-3xl">
      Les coûts et les effets des compétences viennent d'un export des données du jeu 1.0, pas d'une capture d'écran ni d'un forum. L'ordre des points est recalculé
      automatiquement à chaque palier et le total est comparé aux points réellement disponibles à ce niveau : si un build dépasse le budget, la page ne se génère pas.
      Les objets et la nourriture viennent du wiki communautaire, dont les tables ont été modifiées pour la dernière fois avant la 1.0 — c'est signalé quand c'est le cas.
    </p>
    <ul class="text-sm mt-4 space-y-1">
      <li><a href={SOURCES.gameData.url} rel="noopener" class="underline hover:text-flame">{SOURCES.gameData.label}</a></li>
      <li><a href={SOURCES.changelog.url} rel="noopener" class="underline hover:text-flame">{SOURCES.changelog.label}</a></li>
      <li><a href={SOURCES.wiki.url} rel="noopener" class="underline hover:text-flame">{SOURCES.wiki.label}</a></li>
    </ul>
  </section>

  <section id="faq" class="wrap mt-14">
    <h2 class="text-2xl mb-4">Questions fréquentes</h2>
    <div class="faq-list">
      {faq.map((f) => (
        <div class="faq-item">
          <h3 class="faq-q text-lg text-parchment mt-6">{f.q}</h3>
          <p class="faq-a text-ash">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap mt-14">
    <div class="panel p-5 md:p-6">
      <p class="eyebrow mb-2">Aller plus loin</p>
      <p class="text-ash">
        Les fiches complètes par classe : <a href="/fr/builds/mage/" class="text-flame no-underline hover:underline">mage</a>,
        <a href="/fr/builds/guerrier/" class="text-flame no-underline hover:underline">guerrier</a>,
        <a href="/fr/builds/archer/" class="text-flame no-underline hover:underline">archer</a>, et la
        <a href="/fr/builds/" class="text-flame no-underline hover:underline">bibliothèque de builds</a> pour comparer les huit classes d'un coup d'œil.
        Pour comprendre l'arbre avant de choisir, lisez <a href="/fr/arbre-de-competences/" class="text-flame no-underline hover:underline">l'arbre de compétences</a>.
        Et pour tester vos propres répartitions, le <a href="/builder/" class="text-flame no-underline hover:underline">planificateur de builds</a> accepte un lien partageable.
      </p>
    </div>
  </section>
</Base>
