---
import Base from "../../../layouts/Base.astro";
import FrSkillOrder from "../../../components/FrSkillOrder.astro";
import { buildBySlug } from "../../../data/builds";
import { planBuild } from "../../../lib/plan";
import { SITE, SOURCES } from "../../../lib/site";

/**
 * "Build archer" page. French players say "archer" where the game tree says Ranger,
 * and they search "guide archer enshrouded" — so the page leads with aim and arrows,
 * the two things that actually decide whether the build works.
 */
const b = buildBySlug("ranger");
const assassin = buildBySlug("assassin");
const finalCode = planBuild(b).at(-1)!.code;

const faq = [
  {
    q: "Archer ou rôdeur dans Enshrouded ?",
    a: "C'est le même build. L'arbre s'appelle Ranger dans le jeu, et les joueurs francophones disent « archer ». Les nœuds de la branche Ranger sont ceux qui montent les dégâts d'arc, les tirs critiques et les compétences de tir.",
  },
  {
    q: "Quelle flèche utiliser en 1.0 ?",
    a: "Les flèches élémentaires éternelles (Ember, Voltaic, Bone) contre les ennemis faibles à leur élément, et les flèches normales pour déclencher Multi Shot, qui ne fonctionne qu'avec les flèches standard. En 1.0 les versions éternelles s'améliorent comme des armes : vous ne tombez plus en panne de flèches spéciales au niveau 50.",
  },
  {
    q: "Pourquoi viser la tête ?",
    a: "Parce que Skill Shot ajoute jusqu'à +60 % aux dégâts de Skillshot, c'est-à-dire aux tirs qui touchent un point faible. Un archer qui ne vise pas les points faibles perd la moitié de son intérêt : le build récompense la précision, pas le volume de tirs.",
  },
  {
    q: "Archer ou assassin ?",
    a: "L'archer reste à distance et pardonne davantage ; l'assassin est un build de dague, difficile, qui dépend des critiques et du poison. Les deux partagent la Dextérité et une partie de l'arbre rôdeur, mais l'assassin est le build le plus exigeant de la 1.0.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Build archer Enshrouded 1.0 : arc, tirs critiques et flèches éternelles",
    description: "Build archer (Ranger) Enshrouded 1.0 en français : ordre exact des points niveau 1 à 50, flèches, équipement et nourriture.",
    inLanguage: "fr",
    image: `${SITE.url}/img/ranger-960.webp`,
    datePublished: "2026-10-24",
    dateModified: SITE.lastVerified,
    author: { "@type": "Organization", name: SITE.name, url: SITE.url, publishingPrinciples: `${SITE.url}/about/` },
    publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
    mainEntityOfPage: `${SITE.url}/fr/builds/archer/`,
    about: { "@type": "VideoGame", name: "Enshrouded" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: `${SITE.url}/fr/` },
      { "@type": "ListItem", position: 2, name: "Builds", item: `${SITE.url}/fr/builds/` },
      { "@type": "ListItem", position: 3, name: "Build archer", item: `${SITE.url}/fr/builds/archer/` },
    ],
  },
];
---
<Base
  lang="fr"
  title="Build archer Enshrouded 1.0 : arc et flèches éternelles"
  description="Build archer (Ranger) Enshrouded 1.0 en français : ordre exact des points niveau 1 à 50, choix des flèches, équipement et nourriture."
  type="article"
  image="/img/ranger-960.webp"
  jsonLd={jsonLd}
 
>
  <section class="relative overflow-hidden border-b border-flame/15">
    <img src="/img/ranger-960.webp" srcset="/img/ranger-480.webp 480w, /img/ranger-960.webp 960w" sizes="100vw" alt="" width="960" height="640" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover object-right opacity-80" />
    <div class="absolute inset-0 bg-gradient-to-r from-night via-night/80 to-night/0"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-night to-transparent"></div>
    <div class="wrap relative py-14 md:py-20">
      <nav aria-label="Fil d'Ariane" class="text-sm text-mist mb-5"><a href="/fr/" class="hover:text-flame no-underline">Accueil</a> <span aria-hidden="true">/</span> <a href="/fr/builds/" class="hover:text-flame no-underline">Builds</a> <span aria-hidden="true">/</span> <span class="text-ash">Archer</span></nav>
      <div class="flex items-center gap-3 mb-4"><span class={`tier tier-${b.tier}`} title="Tier éditorial">{b.tier}</span><span class="eyebrow">Enshrouded 1.0 · niveau 50</span></div>
      <h1 class="text-3xl md:text-5xl font-bold text-parchment max-w-3xl">Build archer Enshrouded 1.0 <span class="text-flame block text-2xl md:text-3xl mt-2">arc, tirs critiques et flèches éternelles</span></h1>
      <p class="mt-4 text-lg text-ash max-w-2xl">
        L'archer est le build qui récompense le plus la visée : ses dégâts dépendent des tirs sur points faibles, pas du nombre de flèches tirées.
        Voici l'ordre exact des points, le choix des flèches et pourquoi les flèches éternelles changent la fin de partie.
      </p>
      <dl class="mt-7 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-3xl text-sm">
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Difficulté</dt><dd class="text-parchment mt-1">Moyen</dd></div>
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Modes</dt><dd class="text-parchment mt-1">{b.modes.join(" · ")}</dd></div>
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Armes</dt><dd class="text-parchment mt-1">Arc, dague en secours</dd></div>
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Attributs</dt><dd class="text-parchment mt-1">Dextérité, Endurance</dd></div>
      </dl>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="btn btn-flame" href={`/builder/?b=${finalCode}&g=ranger`}>Ouvrir le build dans le planificateur</a>
        <a class="btn btn-ghost" href="#ordre">Ordre des points</a>
      </div>
    </div>
  </section>

  <div class="wrap grid lg:grid-cols-[1fr_16rem] gap-10 mt-10">
    <article class="prose-game min-w-0">
      <div class="panel panel-ornate p-5 md:p-6 my-6 not-prose">
        <p class="eyebrow !text-flame mb-3">Ce que cette page vous donne</p>
        <ul class="space-y-2 text-ash">
          <li class="flex gap-2"><span class="text-spirit">→</span><span>L'ordre des points qui monte d'abord les dégâts d'arc et les critiques, parce que c'est là que se trouve la puissance du build.</span></li>
          <li class="flex gap-2"><span class="text-spirit">→</span><span>Quelles flèches garder et lesquelles oublier en 1.0, maintenant que les versions éternelles s'améliorent.</span></li>
          <li class="flex gap-2"><span class="text-ember">→</span><span>Pas de recette magique : si vous ne visez pas les points faibles, aucun ordre de points ne compense.</span></li>
        </ul>
      </div>

      <h2 id="nom">Archer, rôdeur : de quoi on parle</h2>
      <p>
        Le jeu appelle cette branche <strong>Ranger</strong>. En français, tout le monde dit « archer », et c'est le même build : dégâts d'arc, tirs critiques,
        et une Dextérité qui augmente à la fois les dégâts d'arc et de dague (+5 % par point). C'est pour ça que l'archer garde souvent une dague en secours :
        il n'a pas à changer d'attribut pour que son arme de rechange fonctionne.
      </p>
      <p>
        La 1.0 a ajouté trois compétences à cette branche : <strong>Puncture</strong> (+30 % de dégâts perforants à distance), <strong>Barrage</strong> (les tirs d'arc
        peuvent réparer l'arc) et <strong>Survival Instinct</strong> (un kill au Shroud à l'arc ou à la dague rend du temps au Shroud).
      </p>

      <h2 id="fleches">Les flèches en 1.0 : ce qui change vraiment</h2>
      <p>
        Avant, un archer de haut niveau passait son temps à crafter des flèches spéciales. En 1.0, chaque flèche élémentaire possède une version <strong>Éternelle</strong>
        qui s'améliore comme une arme. Au niveau 50, vous jouez avec des flèches éternelles sans jamais tomber en panne.
      </p>
      <ul>
        <li><strong>Flèches normales</strong> : ce sont les seules à déclencher Multi Shot, qui donne 20 % de chance de tirer une rafale.</li>
        <li><strong>Ember, Voltaic, Bone éternelles</strong> : contre les ennemis faibles à leur élément, et pour les dégâts de zone.</li>
        <li><strong>Multi Shot Trigger</strong> étend Multi Shot aux flèches spéciales — mais il coûte plusieurs points, à prendre après les nœuds de dégâts.</li>
      </ul>

      <h2 id="jouer">Comment le jouer</h2>
      <ul>
        <li>Visez la tête. <strong>Skill Shot</strong> ajoute jusqu'à +60 % aux dégâts de Skillshot, c'est-à-dire aux tirs qui touchent un point faible.</li>
        <li>Gardez la distance avec <strong>Runner</strong> et <strong>Rebound</strong> : la plupart des compétences d'arc récompensent le fait de rester hors de portée de mêlée.</li>
        <li><strong>Bee Sting</strong> permet de rester en vol stationnaire en visant : c'est ce qui rend les groupes d'ennemis gérables depuis un angle élevé.</li>
        <li>Contre les ennemis volants et les archers, <strong>Eagle's Bane</strong> et <strong>Counter Battery</strong> font le travail — ce sont des nœuds de fin de partie, pas de début.</li>
      </ul>

      <FrSkillOrder build={b} headings={{ core: "Compétences clés de l'archer", order: "Ordre des points, niveau 1 à 50", gear: "Équipement, armes et flèches", food: "Nourriture et buffs" }} />

      <h2 id="forces">Points forts et faiblesses</h2>
      <p class="text-sm text-mist">Avis éditorial, pas une donnée du jeu.</p>
      <div class="grid md:grid-cols-2 gap-4 not-prose">
        <div class="panel p-5"><p class="eyebrow !text-spirit mb-2">Points forts</p><ul class="space-y-2 text-ash">{b.pros.map((p) => <li class="flex gap-2"><span class="text-spirit">+</span>{p}</li>)}</ul></div>
        <div class="panel p-5"><p class="eyebrow !text-ember mb-2">Faiblesses</p><ul class="space-y-2 text-ash">{b.cons.map((p) => <li class="flex gap-2"><span class="text-ember">−</span>{p}</li>)}</ul></div>
      </div>

      <section id="faq">
        <h2>Questions fréquentes</h2>
        <div class="faq-list">
          {faq.map((f) => (
            <div class="faq-item">
              <h3 class="faq-q text-lg text-parchment mt-6">{f.q}</h3>
              <p class="faq-a text-ash">{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <h2 id="sources">Sources</h2>
      <ul class="text-sm">
        <li><a href={SOURCES.gameData.url} rel="noopener">{SOURCES.gameData.label}</a></li>
        <li><a href={SOURCES.changelog.url} rel="noopener">{SOURCES.changelog.label}</a></li>
        <li><a href={SOURCES.wiki.url} rel="noopener">{SOURCES.wiki.label}</a></li>
      </ul>
      <p class="text-sm text-mist">Données vérifiées le {SITE.lastVerified} sur Enshrouded {SITE.gameVersion}. Les points forts et faiblesses sont un avis éditorial. Fiche anglaise correspondante : <a href="/builds/ranger/" class="underline hover:text-flame">Ranger build</a>, et pour la dague <a href={`/builds/${assassin.slug}/`} class="underline hover:text-flame">Assassin</a>.</p>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24 panel p-5">
        <p class="eyebrow mb-3">Sur cette page</p>
        <ul class="space-y-1.5 text-sm">
          <li><a href="#nom" class="text-ash hover:text-flame no-underline">Archer ou rôdeur</a></li>
          <li><a href="#fleches" class="text-ash hover:text-flame no-underline">Les flèches en 1.0</a></li>
          <li><a href="#jouer" class="text-ash hover:text-flame no-underline">Comment le jouer</a></li>
          <li><a href="#competences" class="text-ash hover:text-flame no-underline">Compétences clés</a></li>
          <li><a href="#ordre" class="text-ash hover:text-flame no-underline">Ordre des points</a></li>
          <li><a href="#points-libres" class="text-ash hover:text-flame no-underline">Points qui restent</a></li>
          <li><a href="#equipement" class="text-ash hover:text-flame no-underline">Équipement</a></li>
          <li><a href="#faq" class="text-ash hover:text-flame no-underline">Questions fréquentes</a></li>
        </ul>
        <hr class="divider my-4" />
        <a class="btn btn-flame w-full justify-center mt-1 !text-xs" href="/fr/arbre-de-competences/">Comprendre l'arbre</a>
      </div>
    </aside>
  </div>

  <section class="wrap mt-14">
    <h2 class="text-2xl mb-4">Autres builds en français</h2>
    <div class="grid sm:grid-cols-3 gap-4">
      <a href="/fr/builds/mage/" class="panel p-5 no-underline hover:border-flame/50 transition-colors"><p class="font-display text-parchment">Build mage</p><p class="text-sm text-ash mt-1">Mage de bataille, sorcier ou invocateur.</p></a>
      <a href="/fr/builds/guerrier/" class="panel p-5 no-underline hover:border-flame/50 transition-colors"><p class="font-display text-parchment">Build guerrier</p><p class="text-sm text-ash mt-1">Deux mains, rage de sang, variante tank.</p></a>
      <a href="/fr/builds/" class="panel p-5 no-underline hover:border-flame/50 transition-colors"><p class="font-display text-parchment">Tous les builds</p><p class="text-sm text-ash mt-1">Les huit builds de la 1.0, avec tier et difficulté.</p></a>
    </div>
  </section>
</Base>
