---
import Base from "../../layouts/Base.astro";
import BuildCard from "../../components/BuildCard.astro";
import JumpNav from "../../components/JumpNav.astro";
import SkillName from "../../components/SkillName.astro";
import TocAside from "../../components/TocAside.astro";
import VerifiedBadge from "../../components/VerifiedBadge.astro";
import { BUILDS, buildBySlug, type Build } from "../../data/builds";
import { NEW_FOODS, WIKI_EDITED } from "../../data/gear";
import { planBuild } from "../../lib/plan";
import { skill, MAX_POINTS, QOL_SKILLS, REGION_LABEL, TREE } from "../../lib/tree";
import { SITE, SOURCES } from "../../lib/site";

export function getStaticPaths() {
  return BUILDS.map((b) => ({ params: { slug: b.slug } }));
}
const b: Build = buildBySlug(Astro.params.slug!);
const stages = planBuild(b);
const final = stages[stages.length - 1];
const flex = MAX_POINTS - final.pointsUsed;
const qol = QOL_SKILLS.map((t) => ({ type: t, ...skill(t) }));
const qolCost = qol.reduce((a, q) => a + q.cost, 0);
// "Intelligence, then Spirit" already reads as a sentence; other lists get an "and".
const statsText = b.stats.includes(" then ") ? b.stats : b.stats.replace(/, ([^,]+)$/, " and $1");
const related = b.related.map(buildBySlug);
const url = `${SITE.url}/builds/${b.slug}/`;
const toc = [
  ["overview", "Overview"], ["how-to-play", "How to play"], ["core-skills", "Core skills"], ["skill-order", "Skill order (1–50)"], ["qol", "Leftover points"],
  ["gear", "Gear & weapons"], ["food", "Food & buffs"], ["pros-cons", "Pros & cons"], ["faq", "FAQ"],
];
const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "Article", headline: b.title, description: b.description,
    image: `${SITE.url}/img/og-${b.slug}.jpg`, datePublished: "2026-10-17", dateModified: SITE.lastVerified,
    author: { "@type": "Organization", name: SITE.name, url: SITE.url, publishingPrinciples: `${SITE.url}/about/` }, publisher: { "@type": "Organization", name: SITE.name, url: SITE.url, publishingPrinciples: `${SITE.url}/about/` },
    mainEntityOfPage: url, about: { "@type": "VideoGame", name: "Enshrouded" },
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: b.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Builds", item: `${SITE.url}/builds/` },
      { "@type": "ListItem", position: 3, name: `${b.name} Build`, item: url },
    ],
  },
];
---
<Base title={b.title} description={b.description} image={`/img/og-${b.slug}.jpg`} type="article" jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-flame/15">
    <img src={`/img/${b.slug}-960.webp`} srcset={`/img/${b.slug}-480.webp 480w, /img/${b.slug}-960.webp 960w`} sizes="100vw" alt="" width="960" height="640" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover object-right opacity-80" />
    <div class="absolute inset-0 bg-gradient-to-r from-night via-night/80 to-night/0"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-night to-transparent"></div>
    <div class="wrap relative py-14 md:py-20">
      <nav aria-label="Breadcrumb" class="text-sm text-mist mb-5"><a href="/" class="hover:text-flame no-underline">Home</a> <span aria-hidden="true">/</span> <a href="/builds/" class="hover:text-flame no-underline">Builds</a> <span aria-hidden="true">/</span> <span class="text-ash">{b.name}</span></nav>
      <div class="flex items-center gap-3 mb-4"><span class={`tier tier-${b.tier}`} title="Editorial tier ranking">{b.tier}</span><span class="eyebrow">Enshrouded 1.0 · Level 50 build · editorial tier</span></div>
      <h1 class="text-3xl md:text-5xl font-bold text-parchment max-w-3xl">{b.alias ? <>Enshrouded 1.0 {b.name} Build <span class="text-flame block text-2xl md:text-3xl mt-2">({b.alias})</span></> : <>Enshrouded {b.name} Build <span class="text-flame">for 1.0</span></>}</h1>
      <p class="mt-4 text-lg text-ash max-w-2xl">{b.short}</p>
      <dl class="mt-7 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-3xl text-sm">
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Difficulty</dt><dd class="text-parchment mt-1">{b.difficulty}</dd></div>
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Best for</dt><dd class="text-parchment mt-1">{b.modes.join(" · ")}</dd></div>
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Weapons</dt><dd class="text-parchment mt-1">{b.weapons}</dd></div>
        <div class="panel px-4 py-3"><dt class="eyebrow !text-[0.66rem]">Attributes</dt><dd class="text-parchment mt-1">{b.stats}</dd></div>
      </dl>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="btn btn-flame" href={`/builder/?b=${final.code}&g=${b.slug}`}>Open level 50 build in planner</a>
        <a class="btn btn-ghost" href="#skill-order">Skill order</a>
      </div>
    </div>
  </section>

  <div class="wrap grid lg:grid-cols-[1fr_16rem] gap-10 mt-10">
    <article class="prose-game min-w-0">
      <JumpNav items={toc} />
      <VerifiedBadge />

      <div class="panel panel-ornate p-5 md:p-6 my-6 not-prose">
        <p class="eyebrow !text-flame mb-2">Quick answer</p>
        <p class="text-lg text-parchment leading-relaxed">{b.name} — {b.tier}-tier, {b.difficulty} difficulty, best for {b.modes.map((m) => m.toLowerCase()).join(" and ")}. It scales with {statsText}. The level 50 skill order spends {final.pointsUsed} of {MAX_POINTS} points on the core skills below.</p>
        <dl class="mt-5 grid gap-5 sm:grid-cols-[2fr_1fr] text-sm">
          <div>
            <dt class="eyebrow !text-[0.66rem] mb-2">Core skills</dt>
            <dd class="flex flex-wrap gap-1.5">{b.core.slice(0, 8).map((t) => <a href={`/skills/#${t}`} class="chip !text-[0.72rem] no-underline hover:border-flame hover:text-flame">{skill(t).name}</a>)}{b.core.length > 8 && <a href="/skills/" class="text-xs self-center text-mist underline hover:text-flame">+{b.core.length - 8} more</a>}</dd>
          </div>
          <div>
            <dt class="eyebrow !text-ember !text-[0.66rem] mb-2">Main weakness</dt>
            <dd class="text-ash">{b.cons[0]}</dd>
          </div>
        </dl>
        <p class="text-xs text-mist mt-4">Skill order generated from the 1.0 game data (build {TREE.source.gameBuild}) and checked against the point budget for each level — see <a href="/about/" class="underline hover:text-flame">how builds are checked</a>. Tier, strengths and weaknesses are editorial opinion.</p>
      </div>

      <p class="not-prose text-sm text-ash">Also worth reading: {related.map((r, i) => <>{i > 0 && " · "}<a href={`/builds/${r.slug}/`} class="text-flame no-underline hover:underline">{r.name}</a></>)}</p>

      <h2 id="overview">{b.name} build overview</h2>
      {b.intro.map((p) => <p>{p}</p>)}

      <h2 id="how-to-play">How to play the {b.name}</h2>
      <ul>{b.playstyle.map((p) => <li>{p}</li>)}</ul>

      <h2 id="core-skills">Core {b.name} skills in 1.0</h2>
      <p>These are the skills the build depends on. Values are the in-game numbers at max level.</p>
      <div class="panel overflow-x-auto not-prose">
        <table class="table-game table-cards">
          <thead><tr><th>Skill</th><th>Cost</th><th>Effect at max level</th></tr></thead>
          <tbody>
            {b.core.map((t) => { const s = skill(t); return (
              <tr><td class="whitespace-nowrap"><SkillName type={t} name={s.name} /></td><td class="whitespace-nowrap">{s.cost} pt{s.cost > 1 ? "s" : ""}{s.maxLevel > 1 ? ` × ${s.maxLevel}` : ""}</td><td>{s.levels[s.levels.length - 1]}</td></tr>
            ); })}
          </tbody>
        </table>
      </div>

      <h2 id="skill-order">{b.name} 1.0 skill tree progression: level 1 to 50</h2>
      <p>Each stage builds on the one before it, and every skill is connected to the tree. The point totals are exact. "Points available" assumes you have collected the Shroud Roots (1 point) and Elixir Wells (3 points) in the biomes you have finished at that level, on top of the 2 points you get per level.</p>
      {stages.map((st, i) => (
        <section class="panel panel-ornate p-5 md:p-6 my-6 not-prose">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-lg text-flame">{st.label}</h3>
            <span class="text-sm text-ash">{st.pointsUsed} / {st.pointsAvailable} points</span>
          </div>
          <p class="text-ash mt-1 mb-4">{st.summary}</p>
          <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-[0.95rem]">
            {st.added.map((a) => (
              <li class="flex items-center justify-between gap-3 border-b border-parchment/5 pb-1.5">
                <SkillName type={a.type} name={a.name} />
                <span class="text-mist whitespace-nowrap text-sm">{skill(a.type).maxLevel > 1 ? `Lv ${a.from ? `${a.from}→` : ""}${a.to}` : a.to > 1 ? `×${a.to}` : ""} · {a.cost} pt</span>
              </li>
            ))}
          </ol>
          <a href={`/builder/?b=${st.code}&g=${b.slug}`} class="inline-block mt-4 text-sm font-display tracking-wider uppercase text-flame no-underline hover:underline">View stage {i + 1} in the planner →</a>
        </section>
      ))}
      <h2 id="qol">Spending the {flex} leftover points</h2>
      <p>The level 50 plan above spends {final.pointsUsed} of the {MAX_POINTS} points a fully explored character has, which leaves <strong>{flex} points</strong>. The core order stops at the damage path on purpose: it is the part that has to be bought in a fixed sequence. The three skills below are what nearly every player buys next, and they are cheap enough to fit in every build on this site.</p>
      <div class="panel overflow-x-auto not-prose">
        <table class="table-game table-cards">
          <thead><tr><th>Skill</th><th>Cost</th><th>Why it matters</th></tr></thead>
          <tbody>
            {qol.map((q) => (
              <tr>
                <td class="whitespace-nowrap"><SkillName type={q.type} name={q.name} /></td>
                <td class="whitespace-nowrap">{q.cost} pts</td>
                <td>{q.levels[q.levels.length - 1]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>All three cost <strong>{qolCost} points</strong>, which leaves {flex - qolCost} for a second weapon style, the gathering nodes or attribute points (a flat +1 each). You can add them in the <a href={`/builder/?b=${final.code}&g=${b.slug}`}>planner</a> and share the resulting link.</p>

      <nav aria-label="Other builds" class="not-prose panel my-6 flex flex-wrap items-center gap-x-3 gap-y-1 p-4 text-sm">
        <span class="eyebrow !text-[0.66rem]">Other 1.0 builds</span>
        {related.map((r) => <a href={`/builds/${r.slug}/`} class="text-flame no-underline hover:underline">{r.name}</a>)}
      </nav>

      <h2 id="gear">Best {b.name} gear & level 50 weapons</h2>
      <p>Item facts below come from the <a href={SOURCES.wiki.url} rel="noopener">Enshrouded Wiki</a>, from the pages updated for 1.0 (last edited {WIKI_EDITED}); we checked them on {SITE.lastVerified}. Set bonuses for the new level 45 sets are not documented yet, so check them in game before you commit materials.</p>
      {[["Weapons", b.gear.weapons], ["Armor & off-hand", b.gear.armor], [b.gear.extrasLabel, b.gear.extras]].map(([label, list]) => (list as typeof b.gear.weapons).length > 0 && (
        <>
          <h3>{label as string}</h3>
          <div class="grid sm:grid-cols-2 gap-3 not-prose">
            {(list as typeof b.gear.weapons).map((g) => (
              <div class="panel p-4">
                <p class="font-display text-parchment">{g.name}</p>
                <p class="text-xs text-flame tracking-wide uppercase mt-0.5">{g.kind}</p>
                <p class="text-sm text-ash mt-2 leading-snug">{g.facts}</p>
                <a href={g.wiki} rel="noopener" class="text-xs text-mist hover:text-flame mt-2 inline-block">Wiki source ↗</a>
              </div>
            ))}
          </div>
        </>
      ))}

      <h2 id="food">Best food & buffs for the {b.name}</h2>
      <p>You start with 3 food slots and can only have one food of each type active. The Survivor skill Dessert Stomach adds a 4th slot. {b.foodNote}</p>
      <div class="panel overflow-x-auto not-prose">
        <table class="table-game">
          <thead><tr><th>Food</th><th>Buff</th></tr></thead>
          <tbody>{b.food.map((f) => <tr><td class="whitespace-nowrap text-parchment">{f.name}</td><td>{f.effect}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="text-sm text-mist">These values come from the wiki's food tables, which were last edited before 1.0 and may have been rebalanced; we last checked them on {SITE.lastVerified}. New 1.0 foods such as {NEW_FOODS.slice(0, 4).join(", ")} don't have documented buff values yet.</p>

      <h2 id="pros-cons">{b.name} build pros & cons</h2>
      <p class="text-sm text-mist">Editorial judgement, not game data: what the build does well and where it struggles in practice.</p>
      <div class="grid md:grid-cols-2 gap-4 not-prose">
        <div class="panel p-5"><p class="eyebrow !text-spirit mb-2">Strengths</p><ul class="space-y-2 text-ash">{b.pros.map((p) => <li class="flex gap-2"><span class="text-spirit">+</span>{p}</li>)}</ul></div>
        <div class="panel p-5"><p class="eyebrow !text-ember mb-2">Weaknesses</p><ul class="space-y-2 text-ash">{b.cons.map((p) => <li class="flex gap-2"><span class="text-ember">−</span>{p}</li>)}</ul></div>
      </div>

      <h2 id="faq">{b.name} build FAQ</h2>
      {b.faq.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}

      <h2>Sources</h2>
      <ul class="text-sm">
        {[SOURCES.changelog, SOURCES.combat, SOURCES.gameData, SOURCES.wiki].map((s) => <li><a href={s.url} rel="noopener">{s.label}</a></li>)}
      </ul>
      <p class="text-sm text-mist">Found something wrong after a patch? See <a href="/contact/">contact</a>. We update builds when Keen Games changes the numbers.</p>
    </article>

    <TocAside
      items={toc}
      note={`Main regions: ${b.regions.map((r) => REGION_LABEL[r]).join(", ")}`}
      cta={{ href: `/builder/?b=${final.code}&g=${b.slug}`, label: "Open in planner" }}
    />
  </div>

  <section class="wrap mt-16">
    <h2 class="text-2xl mb-5">Related builds</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{related.map((r) => <BuildCard build={r} />)}</div>
  </section>
</Base>
