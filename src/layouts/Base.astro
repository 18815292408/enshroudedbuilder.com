---
import "../styles/global.css";
import { SITE, DISCLAIMER, NAV, NAV_FR } from "../lib/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: object | object[];
  noindex?: boolean;
  /** "fr" switches document language, navigation, footer and consent copy. */
  lang?: "en" | "fr";
  /** The other-language version of this page, for the header switcher and hreflang. */
  altPath?: string;
}
const { title, description, image = "/img/og-default.jpg", type = "website", jsonLd, noindex = false, lang = "en", altPath } = Astro.props;
const fr = lang === "fr";
const nav = fr ? NAV_FR : NAV;
const home = fr ? "/fr/" : "/";
const switchHref = fr ? altPath ?? "/" : altPath ?? "/fr/";
const switchLabel = fr ? "EN" : "FR";
const switchTitle = fr ? "Read the English version" : "Lire la version française";
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altPath && <link rel="alternate" hreflang={fr ? "en" : "fr"} href={new URL(altPath, SITE.url).href} />}
    {altPath && <link rel="alternate" hreflang={lang} href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0c0a10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Cinzel:wght@600;700;900&display=optional" rel="stylesheet" />
    <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
      // Consent Mode v2: everything denied until the visitor allows analytics.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag("consent", "default", { ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", analytics_storage: "denied" });
      try { if (localStorage.getItem("eb-consent") === "granted") gtag("consent", "update", { analytics_storage: "granted" }); } catch (e) {}
      gtag("js", new Date());
      gtag("config", ga4Id);
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
    <slot name="head" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 btn btn-flame">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-flame/15 bg-night/85 backdrop-blur-md">
      <div class="wrap flex items-center justify-between gap-4 h-16">
        <a href={home} class="flex items-center gap-2.5 no-underline group">
          <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="fl" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd27a"/><stop offset="1" stop-color="#e0661e"/></linearGradient></defs><path d="M16 2c2 6 8 8 8 16a8 8 0 0 1-16 0c0-4 2-6 4-8 0 3 1 5 3 5-1-5 1-9 1-13z" fill="url(#fl)"/><path d="M16 30a4 4 0 0 1-4-4c0-3 4-5 4-8 0 3 4 5 4 8a4 4 0 0 1-4 4z" fill="#fff3d6" opacity=".85"/></svg>
          <span class="font-display font-bold text-[1.05rem] tracking-wide text-parchment group-hover:text-flame transition-colors">Enshrouded<span class="text-flame">Builder</span></span>
        </a>
        <nav aria-label={fr ? "Navigation principale" : "Main"} class="hidden md:flex items-center gap-1">
          {nav.map((n) => (
            <a href={n.href} class:list={["px-3 py-2 rounded font-display text-[0.82rem] tracking-[0.12em] uppercase no-underline transition-colors", path.startsWith(n.href) ? "text-flame" : "text-ash hover:text-parchment"]}>{n.label}</a>
          ))}
        </nav>
        <a href={switchHref} hreflang={fr ? "en" : "fr"} lang={fr ? "en" : "fr"} title={switchTitle} aria-label={switchTitle} class="btn btn-ghost !py-2 !px-3 !text-xs font-display tracking-wider">{switchLabel}</a>
        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer btn btn-ghost !py-2 !px-3" aria-label={fr ? "Ouvrir le menu" : "Open menu"}>{fr ? "Menu" : "Menu"}</summary>
          <div class="absolute right-0 mt-2 w-56 panel p-2 flex flex-col">
            {nav.map((n) => <a href={n.href} class="px-3 py-2.5 rounded no-underline text-parchment hover:bg-night-3 font-display text-sm tracking-wider uppercase">{n.label}</a>)}
          </div>
        </details>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="mt-20 border-t border-flame/15 bg-night-2/80">
      <div class="wrap py-10 grid gap-8 md:grid-cols-[1.4fr_1fr_1fr] text-sm">
        <div>
          <p class="font-display text-parchment text-base mb-2">Enshrouded<span class="text-flame">Builder</span></p>
          <p class="text-mist leading-relaxed">{DISCLAIMER}</p>
        </div>
        <div>
          <p class="eyebrow mb-3">{fr ? "Guides en français" : "Guides"}</p>
          <ul class="space-y-1.5 text-ash">
            {fr ? (
              <>
                <li><a class="hover:text-flame no-underline" href="/fr/">Builds Enshrouded 1.0</a></li>
                <li><a class="hover:text-flame no-underline" href="/fr/builds/">Tous les builds par classe</a></li>
                <li><a class="hover:text-flame no-underline" href="/fr/arbre-de-competences/">Arbre de compétences</a></li>
                <li><a class="hover:text-flame no-underline" href="/builder/">Planificateur de builds</a></li>
              </>
            ) : (
              <>
                <li><a class="hover:text-flame no-underline" href="/builds/">All 1.0 builds</a></li>
                <li><a class="hover:text-flame no-underline" href="/builder/">Skill tree planner</a></li>
                <li><a class="hover:text-flame no-underline" href="/skills/">1.0 skills list</a></li>
                <li><a class="hover:text-flame no-underline" href="/fr/">Guides en français</a></li>
              </>
            )}
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-3">{fr ? "Site" : "Site"}</p>
          <ul class="space-y-1.5 text-ash">
            <li><a class="hover:text-flame no-underline" href="/about/">{fr ? "À propos et sources" : "About & sources"}</a></li>
            <li><a class="hover:text-flame no-underline" href="/privacy/">{fr ? "Confidentialité" : "Privacy"}</a></li>
            <li><button type="button" data-consent-open class="hover:text-flame cursor-pointer">{fr ? "Paramètres de mesure d'audience" : "Analytics settings"}</button></li>
            <li><a class="hover:text-flame no-underline" href="/contact/">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap pb-8 text-xs text-mist">
        {fr ? (
          <>
            Données de jeu vérifiées le {SITE.lastVerified} sur Enshrouded {SITE.gameVersion}. Équipements et nourriture repris du{" "}
            <a class="underline hover:text-flame" href="https://enshrouded.wiki.gg/" rel="noopener">Enshrouded Wiki</a> (CC BY-SA 4.0).
          </>
        ) : (
          <>
            Game data last verified {SITE.lastVerified} against Enshrouded {SITE.gameVersion}. Item and food details adapted from the{" "}
            <a class="underline hover:text-flame" href="https://enshrouded.wiki.gg/" rel="noopener">Enshrouded Wiki</a> (CC BY-SA 4.0).
          </>
        )}
      </div>
    </footer>
    <div id="consent" role="dialog" aria-live="polite" aria-label={fr ? "Consentement à la mesure d'audience" : "Analytics consent"} hidden class="fixed inset-x-3 bottom-3 z-50 sm:left-auto sm:right-4 sm:bottom-4 sm:max-w-sm panel panel-ornate p-4 text-sm">
      <p class="text-parchment">
        {fr
          ? "Nous utilisons Google Analytics et Microsoft Clarity pour des statistiques anonymes et agrégées. Rien ne se charge avant votre accord."
          : "We use Google Analytics and Microsoft Clarity for anonymous, aggregated statistics. Nothing loads until you allow it."}
      </p>
      <p class="mt-1 text-mist"><a href="/privacy/" class="underline hover:text-flame">{fr ? "Politique de confidentialité" : "Privacy policy"}</a></p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-consent="granted" class="btn btn-flame !py-2 !px-3 !text-xs">{fr ? "Autoriser" : "Allow analytics"}</button>
        <button type="button" data-consent="denied" class="btn btn-ghost !py-2 !px-3 !text-xs">{fr ? "Refuser" : "Decline"}</button>
      </div>
    </div>
    <script is:inline define:vars={{ clarityId: SITE.clarityId }}>
      (function () {
        var box = document.getElementById("consent");
        var read = function () { try { return localStorage.getItem("eb-consent"); } catch (e) { return null; } };
        var loadClarity = function () {
          if (window.clarity) return;
          (function (c, l, a, r, i, t, y) { c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); }; t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i; y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y); })(window, document, "clarity", "script", clarityId);
        };
        var apply = function (choice) {
          try { localStorage.setItem("eb-consent", choice); } catch (e) {}
          /* Ad signals stay denied: the site runs no ad network while the AdSense review is pending. */
          gtag("consent", "update", { analytics_storage: choice, ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied" });
          if (choice === "granted") { loadClarity(); gtag("event", "page_view"); }
          box.hidden = true;
        };
        var state = read();
        if (state === "granted") loadClarity();
        if (!state) box.hidden = false;
        box.addEventListener("click", function (e) { var c = e.target.closest("[data-consent]"); if (c) apply(c.getAttribute("data-consent")); });
        document.querySelectorAll("[data-consent-open]").forEach(function (b) { b.addEventListener("click", function () { box.hidden = false; }); });
      })();
    </script>
  </body>
</html>
